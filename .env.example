# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and must never be committed.
# Next.js reads these at process start — restart `pnpm dev` after changing them.

# ----- Supabase: public (sent to the browser) -----
# Project URL, from the Supabase dashboard: Project Settings -> Data API.
NEXT_PUBLIC_SUPABASE_URL=
# Anon/publishable key for the same project; safe in the browser because every
# table is protected by row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Supabase: server-only (never expose to the browser) -----
# Service-role key; bypasses row-level security, so it is only read by server
# code and by scripts/create-staff-user.ts.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Transcript encryption -----
# Passphrase for the pgcrypto symmetric encryption of interview transcripts.
# Any high-entropy string; if it is lost, existing transcripts cannot be decrypted.
TRANSCRIPT_ENCRYPTION_KEY=

# ----- AI providers -----
# Gemini API key, from Google AI Studio. Used by the interview, chart selector,
# SOAP generator, and the evaluation harness.
GOOGLE_GENERATIVE_AI_API_KEY=
# Groq API key, from the Groq console. Used only by the Referee agent, which
# must run on a different provider than the agent it audits.
GROQ_API_KEY=

# ----- Development only -----
# Set to "true" to stop proxy.ts enforcing the idle/absolute session timeouts.
# Leave blank in any deployed environment.
DISABLE_SESSION_TIMEOUT=
